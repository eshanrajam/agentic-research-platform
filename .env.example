# ---- Model provider (configure exactly one; priority: Azure OpenAI > Foundry > OpenAI) ----
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=

# ---- Optional: higher-quality web search for the Researcher agent's MCP tool ----
# Falls back to free DuckDuckGo HTML search when not set.
TAVILY_API_KEY=

# ---- Observability (optional; falls back to console tracing) ----
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- RAG / knowledge base ----
CHROMA_PERSIST_DIR=./data/chroma

# ---- Security switch for the Coder agent's sandboxed execution tool ----
# Keep false unless you understand the risk (see README > Security). Demo/dev use only.
ENABLE_CODE_EXECUTION=false

# ---- API server ----
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_ORCHESTRATOR_STEPS=8
